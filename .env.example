# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - BACKEND DJANGO (RENDER)
# ==============================================================================

# Seguridad de Django
SECRET_KEY=tu-clave-secreta-de-produccion-de-mas-de-50-caracteres
DJANGO_DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Base de Datos PostgreSQL (Neon)
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=tu-contraseña-de-neon
DB_HOST=ep-tu-endpoint-pooler.us-east-2.aws.neon.tech
DB_PORT=5432

# Almacenamiento de Imágenes en la Nube (Cloudinary)
CLOUDINARY_CLOUD_NAME=tu-cloudinary-cloud-name
CLOUDINARY_API_KEY=tu-cloudinary-api-key
CLOUDINARY_API_SECRET=tu-cloudinary-api-secret

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token-de-mercadopago

# URLs de la Aplicación
# FRONTEND_URL: la URL de tu proyecto en Vercel
FRONTEND_URL=https://tu-tienda.vercel.app
# BACKEND_URL: la URL de este servicio en Render
BACKEND_URL=https://tu-api.onrender.com

# Servicio de Correo (Gmail SMTP)
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion-de-gmail
